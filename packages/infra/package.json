{
  "name": "@sentinel/infra",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run --env-file=../../.env ./src/db/migrate.ts",
    "db:seed": "bun run --env-file=../../.env ./src/cli/seed.ts",
    "owner:create": "bun run --env-file=../../.env ./src/cli/owner-create.ts",
    "secrets:reencrypt": "bun run --env-file=../../.env ./src/crypto/secrets-reencrypt.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/otlp-exporter-base": "0.300.0",
    "@opentelemetry/otlp-transformer": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@sentinel/application": "workspace:*",
    "@sentinel/contracts": "workspace:*",
    "@sentinel/domain": "workspace:*",
    "drizzle-orm": "0.45.4",
    "libsodium-wrappers-sumo": "0.8.4",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/libsodium-wrappers-sumo": "0.8.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
