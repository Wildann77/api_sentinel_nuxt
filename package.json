{
  "name": "api-sentinel-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun --filter @sentinel/web dev",
    "dev:worker": "bun --filter @sentinel/worker dev",
    "build": "bun --filter '*' build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:boundaries": "depcruise --config .dependency-cruiser.js packages apps",
    "test:boundaries": "vitest run tests/boundary-violation.test.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "bun --filter @sentinel/infra db:generate",
    "db:migrate": "bun --filter @sentinel/infra db:migrate",
    "owner:create": "bun --filter @sentinel/infra owner:create",
    "secrets:reencrypt": "bun --filter @sentinel/infra secrets:reencrypt"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@testcontainers/postgresql": "^10.19.0",
    "@types/node": "^24.11.1",
    "@vitest/coverage-v8": "^3.2.0",
    "dependency-cruiser": "18.7.0",
    "testcontainers": "^10.19.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.0"
  }
}
